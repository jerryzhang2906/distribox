; opengl32.dll proxy — intercepts WGL functions, forwards rest
EXPORTS
  wglSwapBuffers    = proxy_wglSwapBuffers
  wglMakeCurrent    = proxy_wglMakeCurrent
  wglCreateContext  = proxy_wglCreateContext
  wglGetProcAddress = proxy_wglGetProcAddress
  ; All other exports forwarded to opengl32_orig.dll
  wglDeleteContext  = opengl32_orig.wglDeleteContext
  wglShareLists     = opengl32_orig.wglShareLists
  wglCopyContext    = opengl32_orig.wglCopyContext
  glAccum           = opengl32_orig.glAccum
  glAlphaFunc       = opengl32_orig.glAlphaFunc
  glBegin           = opengl32_orig.glBegin
  glBindTexture     = opengl32_orig.glBindTexture
  glBlendFunc       = opengl32_orig.glBlendFunc
  glClear           = opengl32_orig.glClear
  glClearColor      = opengl32_orig.glClearColor
  glClearDepth      = opengl32_orig.glClearDepth
  glClearStencil    = opengl32_orig.glClearStencil
  glColor3f         = opengl32_orig.glColor3f
  glColor4f         = opengl32_orig.glColor4f
  glColorMask       = opengl32_orig.glColorMask
  glCullFace        = opengl32_orig.glCullFace
  glDeleteTextures  = opengl32_orig.glDeleteTextures
  glDepthFunc       = opengl32_orig.glDepthFunc
  glDepthMask       = opengl32_orig.glDepthMask
  glDepthRange      = opengl32_orig.glDepthRange
  glDisable         = opengl32_orig.glDisable
  glDrawArrays      = opengl32_orig.glDrawArrays
  glDrawBuffer      = opengl32_orig.glDrawBuffer
  glDrawElements    = opengl32_orig.glDrawElements
  glEnable          = opengl32_orig.glEnable
  glEnd             = opengl32_orig.glEnd
  glFinish          = opengl32_orig.glFinish
  glFlush           = opengl32_orig.glFlush
  glFrontFace       = opengl32_orig.glFrontFace
  glGenTextures     = opengl32_orig.glGenTextures
  glGetBooleanv     = opengl32_orig.glGetBooleanv
  glGetDoublev      = opengl32_orig.glGetDoublev
  glGetError        = opengl32_orig.glGetError
  glGetFloatv       = opengl32_orig.glGetFloatv
  glGetIntegerv     = opengl32_orig.glGetIntegerv
  glGetString       = opengl32_orig.glGetString
  glGetTexImage     = opengl32_orig.glGetTexImage
  glHint            = opengl32_orig.glHint
  glLightfv         = opengl32_orig.glLightfv
  glLineWidth       = opengl32_orig.glLineWidth
  glLoadIdentity    = opengl32_orig.glLoadIdentity
  glLoadMatrixd     = opengl32_orig.glLoadMatrixd
  glLoadMatrixf     = opengl32_orig.glLoadMatrixf
  glLogicOp         = opengl32_orig.glLogicOp
  glMaterialfv      = opengl32_orig.glMaterialfv
  glMatrixMode      = opengl32_orig.glMatrixMode
  glMultMatrixd     = opengl32_orig.glMultMatrixd
  glMultMatrixf     = opengl32_orig.glMultMatrixf
  glNormal3f        = opengl32_orig.glNormal3f
  glOrtho           = opengl32_orig.glOrtho
  glPixelStorei     = opengl32_orig.glPixelStorei
  glPointSize       = opengl32_orig.glPointSize
  glPolygonMode     = opengl32_orig.glPolygonMode
  glPopMatrix       = opengl32_orig.glPopMatrix
  glPushMatrix      = opengl32_orig.glPushMatrix
  glReadPixels      = opengl32_orig.glReadPixels
  glRotated         = opengl32_orig.glRotated
  glRotatef         = opengl32_orig.glRotatef
  glScaled          = opengl32_orig.glScaled
  glScalef          = opengl32_orig.glScalef
  glScissor         = opengl32_orig.glScissor
  glShadeModel      = opengl32_orig.glShadeModel
  glStencilFunc     = opengl32_orig.glStencilFunc
  glStencilMask     = opengl32_orig.glStencilMask
  glStencilOp       = opengl32_orig.glStencilOp
  glTexCoord2f      = opengl32_orig.glTexCoord2f
  glTexEnvf         = opengl32_orig.glTexEnvf
  glTexImage1D      = opengl32_orig.glTexImage1D
  glTexImage2D      = opengl32_orig.glTexImage2D
  glTexParameterf   = opengl32_orig.glTexParameterf
  glTexParameteri   = opengl32_orig.glTexParameteri
  glTexSubImage2D   = opengl32_orig.glTexSubImage2D
  glTranslated      = opengl32_orig.glTranslated
  glTranslatef      = opengl32_orig.glTranslatef
  glVertex2f        = opengl32_orig.glVertex2f
