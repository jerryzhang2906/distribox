; OpenCL.dll proxy — exports all OpenCL API functions
; clGetPlatformIDs is intercepted; everything else forwarded to OpenCL_orig.dll

EXPORTS
  clGetPlatformIDs        = proxy_clGetPlatformIDs
  clGetPlatformInfo       = proxy_clGetPlatformInfo
  clGetDeviceIDs          = proxy_clGetDeviceIDs
  clGetDeviceInfo         = proxy_clGetDeviceInfo
  clCreateContext         = proxy_clCreateContext
  clCreateContextFromType = proxy_clCreateContextFromType
  clRetainContext         = proxy_clRetainContext
  clReleaseContext        = proxy_clReleaseContext
  clGetContextInfo        = proxy_clGetContextInfo
  clCreateCommandQueue    = proxy_clCreateCommandQueue
  clCreateCommandQueueWithProperties = proxy_clCreateCommandQueueWithProperties
  clRetainCommandQueue    = proxy_clRetainCommandQueue
  clReleaseCommandQueue   = proxy_clReleaseCommandQueue
  clGetCommandQueueInfo   = proxy_clGetCommandQueueInfo
  clCreateBuffer          = proxy_clCreateBuffer
  clCreateSubBuffer       = proxy_clCreateSubBuffer
  clRetainMemObject       = proxy_clRetainMemObject
  clReleaseMemObject      = proxy_clReleaseMemObject
  clGetMemObjectInfo      = proxy_clGetMemObjectInfo
  clEnqueueReadBuffer     = proxy_clEnqueueReadBuffer
  clEnqueueWriteBuffer    = proxy_clEnqueueWriteBuffer
  clEnqueueFillBuffer     = proxy_clEnqueueFillBuffer
  clEnqueueCopyBuffer     = proxy_clEnqueueCopyBuffer
  clCreateProgramWithSource = proxy_clCreateProgramWithSource
  clCreateProgramWithBinary = proxy_clCreateProgramWithBinary
  clRetainProgram         = proxy_clRetainProgram
  clReleaseProgram        = proxy_clReleaseProgram
  clBuildProgram          = proxy_clBuildProgram
  clGetProgramBuildInfo   = proxy_clGetProgramBuildInfo
  clGetProgramInfo        = proxy_clGetProgramInfo
  clCreateKernel          = proxy_clCreateKernel
  clRetainKernel          = proxy_clRetainKernel
  clReleaseKernel         = proxy_clReleaseKernel
  clSetKernelArg          = proxy_clSetKernelArg
  clGetKernelInfo         = proxy_clGetKernelInfo
  clEnqueueNDRangeKernel  = proxy_clEnqueueNDRangeKernel
  clEnqueueTask           = proxy_clEnqueueTask
  clFinish                = proxy_clFinish
  clFlush                 = proxy_clFlush
  clWaitForEvents         = proxy_clWaitForEvents
  clGetEventInfo          = proxy_clGetEventInfo
  clRetainEvent           = proxy_clRetainEvent
  clReleaseEvent          = proxy_clReleaseEvent
  clGetEventProfilingInfo = proxy_clGetEventProfilingInfo
  clCreateUserEvent       = proxy_clCreateUserEvent
  clSetUserEventStatus    = proxy_clSetUserEventStatus
  clSetEventCallback      = proxy_clSetEventCallback
  clIcdGetPlatformIDsKHR  = proxy_clIcdGetPlatformIDsKHR
